{# X1Wrt login page - SPDX-License-Identifier: Apache-2.0 -#}
{% const boardinfo = ubus.call('system', 'board'); -%}
{% include('header', { blank_page: true }) %}

<div class="x1-login-screen">
	<div class="x1-login-bg" aria-hidden="true">
		<span></span><span></span><span></span><span></span>
	</div>

	<form method="post" class="x1-login-card">
		<div class="x1-login-brand">
			<img src="{{ media }}/images/logo.svg" alt="">
			<div>
				<strong>{{ striptags(boardinfo?.hostname ?? 'OpenWrt') }}</strong>
				<small>{{ _('Authorization Required') }}</small>
			</div>
		</div>

		<div class="x1-login-copy">
			<h1>{{ _('Welcome back') }}</h1>
			<p>{{ _('Sign in to manage your OpenWrt router.') }}</p>
		</div>

		{% if (fuser): %}
		<div class="x1-login-error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
		{% endif %}

		<label class="x1-login-field" for="luci_username">
			<span>{{ _('Username') }}</span>
			<input name="luci_username" id="luci_username" type="text" value="{{ entityencode(duser ?? '', true) }}" autocomplete="username">
		</label>

		<label class="x1-login-field" for="luci_password">
			<span>{{ _('Password') }}</span>
			<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">
		</label>

		<button type="submit" class="x1-login-submit">{{ _('Log in') }}</button>
		<p class="x1-login-foot">{{ version.distname }} {{ version.distversion }} · {{ version.luciname }}</p>
	</form>
</div>

<script>
(function () {
	var user = document.getElementById('luci_username');
	var pass = document.getElementById('luci_password');
	(user && user.value ? pass : user)?.focus();
})();
</script>

{% include('footer', { blank_page: true }) %}
