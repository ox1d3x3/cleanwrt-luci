#!/bin/sh

# Register CleanX and remove old development theme names from the LuCI design list.
# During package upgrade, keep the user's current theme selection unless it still
# points to an old CleanX development path.

uci -q batch <<-'UCI'
	delete luci.themes.UniWRT
	delete luci.themes.uniwrt
	delete luci.themes.X1Wrt
	delete luci.themes.x1wrt
	set luci.themes.CleanX='/luci-static/cleanx'
UCI

current_media="$(uci -q get luci.main.mediaurlbase)"
if [ "$PKG_UPGRADE" != "1" ] || [ "$current_media" = "/luci-static/uniwrt" ] || [ "$current_media" = "/luci-static/x1wrt" ]; then
	uci -q set luci.main.mediaurlbase='/luci-static/cleanx'
fi

# Theme config used by the frontend JS. Safe defaults only.
uci -q get cleanx.theme >/dev/null 2>&1 || {
	uci -q batch <<-'UCI'
		set cleanx.theme='theme'
		set cleanx.theme.mode='auto'
		set cleanx.theme.dashboard='1'
		set cleanx.theme.wan_interface='auto'
		set cleanx.theme.animations='balanced'
	UCI
}

uci -q commit luci
uci -q commit cleanx

exit 0
