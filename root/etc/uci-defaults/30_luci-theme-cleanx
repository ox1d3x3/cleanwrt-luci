#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Register CleanX in LuCI (package installs only; the standalone installer,
# cleanx-apply.sh, does the same registration itself).
#
# Fresh install: CleanX becomes the active theme.
# Upgrade:       the user's current theme choice is kept.
#
# Very early CleanX builds were published under the names UniWRT and X1Wrt.
# Their theme entries are cleaned up, but only when that theme is not actually
# installed: UniWRT Portal is now a separate, real theme that can sit
# alongside CleanX.

for legacy in uniwrt:UniWRT uniwrt:UniWRTDark uniwrt:UniWRTLight uniwrt:uniwrt x1wrt:X1Wrt x1wrt:x1wrt; do
	dir="${legacy%%:*}"
	name="${legacy#*:}"
	[ -d "/www/luci-static/$dir" ] && continue
	uci -q delete "luci.themes.$name"
	[ "$(uci -q get luci.main.mediaurlbase)" = "/luci-static/$dir" ] && \
		uci -q set luci.main.mediaurlbase='/luci-static/cleanx'
done

uci -q set luci.themes.CleanX='/luci-static/cleanx'
[ "$PKG_UPGRADE" = "1" ] || uci -q set luci.main.mediaurlbase='/luci-static/cleanx'
uci -q commit luci

rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache 2>/dev/null

exit 0
