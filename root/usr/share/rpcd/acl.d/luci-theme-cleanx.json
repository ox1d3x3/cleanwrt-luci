				],
				"network.device": [
					"status"
				],
				"luci-rpc": [
					"getBoardJSON",
					"getHostHints",
					"getNetworkDevices",
					"getWirelessDevices"
				],
				"iwinfo": [
					"assoclist"
				],
				"fingerprint": [
